# Copy to `.env` for local development. `.env` is git-ignored; never commit
# real credentials.

# Required. PostgreSQL connection string used for metadata and control state.
HOMECLOUD_DATABASE_URL=postgres://homecloud:homecloud@127.0.0.1:5432/homecloud

# Optional. Bounded connection pool size (1-128). Default: 8.
HOMECLOUD_DATABASE_MAX_CONNECTIONS=8

# Optional. Address the API binds to. Default: 127.0.0.1:8080 (loopback only).
# Exposing the API to a network is an explicit decision; put a TLS-terminating
# reverse proxy in front of it.
HOMECLOUD_LISTEN_ADDR=127.0.0.1:8080

# Optional. Canonical root of the file library. Default: ./data/library
HOMECLOUD_STORAGE_ROOT=./data/library

# Optional. `development` (default) or `production`. Affects log format and
# diagnostics verbosity only.
HOMECLOUD_ENV=development

# Optional. Comma-separated origins allowed to make state-changing requests,
# for deployments behind a reverse proxy that rewrites the `Host` header
# (for example `https://home.example`). In development, loopback origins are
# accepted automatically; in production they are not.
HOMECLOUD_TRUSTED_ORIGINS=

# Optional, but required for passkeys. The address people reach this server at,
# such as https://home.example or http://localhost:3000. WebAuthn binds a
# credential to this origin, so it cannot be inferred from a request header.
# It is also trusted for cross-origin request checks.
HOMECLOUD_PUBLIC_ORIGIN=
